# Docker runs on the remote Ubuntu host. This is a path on that host.
# Default: ~/sdc_ros2/midterm01/data (relative to this Compose project).
# An existing dataset elsewhere can be selected with an absolute Linux path.
# The selected directory must contain Track1/ and Track2/.
MIDTERM_DATA_DIR=./data

# Separate from the HW2 ros2_container and ROS_DOMAIN_ID=0.
MIDTERM_CONTAINER_NAME=sdc_midterm01
ROS_DOMAIN_ID=1

