Panels:
  - Class: rviz_common/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded: ~
      Splitter Ratio: 0.6
    Tree Height: 420
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.4
      Cell Size: 5
      Class: rviz_default_plugins/Grid
      Color: 120; 120; 120
      Enabled: true
      Name: Grid (5 m)
      Plane: XY
      Plane Cell Count: 12
      Reference Frame: map
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 3600
      Marker Scale: 2
      Name: TF
      Show Arrows: false
      Show Axes: true
      Show Names: true
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/PointCloud2
      Color Transformer: RGB8
      Decay Time: 0
      Enabled: true
      Name: Map (keyframes, RGB)
      Position Transformer: XYZ
      Size (Pixels): 2
      Style: Points
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /vslam/map
      Value: true
    - Alpha: 0.6
      Class: rviz_default_plugins/PointCloud2
      Color: 80; 160; 255
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: false
      Name: Local submap (registration target)
      Position Transformer: XYZ
      Size (Pixels): 2
      Style: Points
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /vslam/submap
      Value: false
    - Alpha: 1
      Class: rviz_default_plugins/PointCloud2
      Color: 255; 60; 60
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Name: Current frame cloud
      Position Transformer: XYZ
      Size (Pixels): 3
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /vslam/current_cloud
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/Path
      Color: 150; 150; 150
      Enabled: true
      Line Style: Lines
      Name: Path odometry (no loop closure)
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /vslam/path_odometry
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/Path
      Color: 255; 200; 0
      Enabled: true
      Line Style: Billboards
      Line Width: 0.08
      Name: Path live
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /vslam/path_live
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/Path
      Color: 0; 170; 255
      Enabled: true
      Line Style: Billboards
      Line Width: 0.12
      Name: Path optimized (shown when run ends)
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /vslam/path_optimized
      Value: true
    - Arrow Length: 0.4
      Class: rviz_default_plugins/PoseArray
      Color: 255; 120; 0
      Enabled: true
      Name: Keyframes
      Shape: Arrow (Flat)
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /vslam/keyframes
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Loop edges + camera frustum
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /vslam/markers
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Max Value: 1
      Min Value: 0
      Name: Features and status
      Normalize Range: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /vslam/features/image
      Value: true
    - Class: rviz_default_plugins/Camera
      Enabled: true
      Image Rendering: background and overlay
      Name: Camera (3D overlay)
      Overlay Alpha: 0.5
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /vslam/camera/image_raw
      Value: true
      Visibility:
        Current frame cloud: false
        Grid (5 m): false
        Keyframes: true
        Local submap (registration target): false
        Loop edges + camera frustum: false
        Map (keyframes, RGB): false
        Path live: true
        Path odometry (no loop closure): false
        Path optimized (shown when run ends): true
        TF: false
        Value: true
      Zoom Factor: 1
  Enabled: true
  Global Options:
    Background Color: 25; 25; 30
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 45
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 2
        Y: 5
        Z: 0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 1.1
      Target Frame: map
      Value: Orbit (rviz_default_plugins)
      Yaw: 3.14
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 1000
  Hide Left Dock: false
  Hide Right Dock: false
  Views:
    collapsed: true
  Width: 1800
  X: 60
  Y: 30
